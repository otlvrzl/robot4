# .env.example - a template for your personal .env file.
#
# You normally do not need to copy this by hand: `bash setup.sh` creates .env for you
# with the right numbers for YOUR computer. The real .env is NOT stored in git
# (it holds machine-specific values); this example file is, so others can see what is needed.

HOST_UID=1000        # your user ID  (check with: id -u)
HOST_GID=1000        # your group ID (check with: id -g)
VIDEO_GID=44         # ID of the "video" group  (getent group video)
RENDER_GID=992       # ID of the "render" group (getent group render)
SOFTWARE_RENDER=0    # set to 1 if Gazebo/RViz show graphics errors (slower, works everywhere)
GZ_IP=127.0.0.1      # network address Gazebo uses; keep the default
