<?xml version="1.0"?>
<!--
  room_world.sdf - a closed rectangular room with a few obstacles inside.

  (SDF is Gazebo's native file format. URDF describes robots, SDF describes worlds.)

  Top view of the room (x to the right, y up). The robot spawns at the centre (0, 0).
  The numbers are the positions (x, y) of the objects in metres:

        y = +3.1  ======================== north wall ========================
                  |                                                          |
                  |        cylinder (-1.5, 1.8)         box_1 (2.0, 1.5)     |
      west wall   |                                                          |  east wall
      x = -4.1    |                      robot (0, 0)                        |  x = +4.1
                  |                                                          |
                  |    box_2 (-2.5, -1.5)           partition (0.8, -2.0)    |
                  |                                       |                  |
        y = -3.1  ======================== south wall ========================

  The free floor inside is 8 m (x: -4 ... +4) by 6 m (y: -3 ... +3).

  IMPORTANT: the world name below (room_world) must be the same as the file name
  (room_world.sdf). The launch file uses it to spawn the robot and to bridge topics.
-->
<sdf version="1.9">
  <world name="room_world">

    <!-- Physics settings: simulate in steps of 1 millisecond. Smaller = more accurate, slower. -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>   <!-- 1.0 = simulated time runs at real-time speed -->
    </physics>

    <!-- SYSTEMS: Gazebo is made of small modules; we list the ones this world needs. -->
    <!-- Physics: gravity, collisions, movement. Without it nothing would move. -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <!-- UserCommands: lets the Gazebo window (and our spawn command) add/move objects. -->
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <!-- SceneBroadcaster: sends the world state to the Gazebo window so you can see it. -->
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <!-- Sensors: computes the sensor data. The LIDAR will NOT work without this one. -->
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>   <!-- the 3D renderer used by camera/LIDAR sensors -->
    </plugin>

    <!-- Look of the scene: soft overall light, light-blue sky colour, shadows on. -->
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.8 0.9 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- The sun: a directional light, as if coming from very far away. -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- The ground: a big flat plane. <static> = it never moves.
         It needs BOTH a collision (so the robot does not fall through)
         and a visual (so we can see it). -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- =====================  THE FOUR WALLS  =====================
         Every wall is a static box, 1 m high and 0.2 m thick.
         <pose> = "x y z roll pitch yaw". z = 0.5 lifts a 1 m high box so it
         stands ON the ground. Each box needs a collision (solid for the robot and
         for the LIDAR laser beams) and a visual (so we can see it).

         The wall centres are 0.1 m outside the room's 8 x 6 m floor, so the free
         space inside is exactly 8 x 6 m. The north and south walls are a bit longer
         (8.4 m) so that they close the corners.
    -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 3.1 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>8.4 0.2 1</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>8.4 0.2 1</size></box></geometry>
          <material><ambient>0.85 0.85 0.8 1</ambient><diffuse>0.85 0.85 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_south">
      <static>true</static>
      <pose>0 -3.1 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>8.4 0.2 1</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>8.4 0.2 1</size></box></geometry>
          <material><ambient>0.85 0.85 0.8 1</ambient><diffuse>0.85 0.85 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_east">
      <static>true</static>
      <pose>4.1 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 6 1</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.2 6 1</size></box></geometry>
          <material><ambient>0.85 0.85 0.8 1</ambient><diffuse>0.85 0.85 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_west">
      <static>true</static>
      <pose>-4.1 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 6 1</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.2 6 1</size></box></geometry>
          <material><ambient>0.85 0.85 0.8 1</ambient><diffuse>0.85 0.85 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- =====================  OBSTACLES INSIDE THE ROOM  =====================
         Different shapes and sizes, so that the robot (and later the map) has
         something interesting to deal with. All are static (they never move). -->

    <!-- A 0.8 m cube (orange). -->
    <model name="box_1">
      <static>true</static>
      <pose>2.0 1.5 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.8 0.8 0.8</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.8 0.8 0.8</size></box></geometry>
          <material><ambient>0.9 0.5 0.1 1</ambient><diffuse>0.9 0.5 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- A longer, narrower box (green), turned by 30 degrees (yaw = 0.52 rad). -->
    <model name="box_2">
      <static>true</static>
      <pose>-2.5 -1.5 0.4 0 0 0.52</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.0 0.6 0.8</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>1.0 0.6 0.8</size></box></geometry>
          <material><ambient>0.2 0.6 0.3 1</ambient><diffuse>0.2 0.6 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- A round column (purple). The LIDAR sees round shapes as curved lines. -->
    <model name="cylinder_1">
      <static>true</static>
      <pose>-1.5 1.8 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.35</radius><length>0.8</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.35</radius><length>0.8</length></cylinder></geometry>
          <material><ambient>0.5 0.3 0.7 1</ambient><diffuse>0.5 0.3 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- A short partition wall that sticks out of the south wall (blue-grey).
         It spans y = -3 ... -1, so the robot can drive around its free end. -->
    <model name="partition">
      <static>true</static>
      <pose>0.8 -2.0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.15 2.0 1</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.15 2.0 1</size></box></geometry>
          <material><ambient>0.4 0.5 0.6 1</ambient><diffuse>0.4 0.5 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
